# Database (MongoDB Atlas)
NUXT_MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/finance?retryWrites=true&w=majority

# Authentication & JWT
NUXT_SECRETJWT=your-secret-jwt-key
NUXT_AUTH_SECRET=your-auth-secret
NUXT_NEXTAUTH_SECRET=your-auth-secret

# Google OAuth
NUXT_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NUXT_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis (Cache & Session)
NUXT_REDIS_URL=redis://default:<password>@localhost:6379

# Resend API Key (Email Service)
RESEND_API_KEY=re_your_resend_api_key
